{
    "name": "@gtindependence/nestjs-common",
    "version": "24.0.0",
    "description": "Our common decorators, services, etc for NestJS projects",
    "keywords": [
        "Typescript",
        "NestJS",
        "Seed"
    ],
    "main": "index.js",
    "typings": "index.d.ts",
    "author": "TeamMaestro + GTIndependence",
    "license": "ISC",
    "homepage": "https://github.com/gtindependence/nestjs-common",
    "repository": {
        "type": "git",
        "url": "https://github.com/gtindependence/nestjs-common.git"
    },
    "bugs": {
        "url": "https://github.com/gtindependence/nestjs-common/issues"
    },
    "files": [
        "index.js",
        "index.d.ts",
        "modules/**/*.js",
        "modules/**/*.d.ts"
    ],
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "watch": "tsc -w",
        "start": "npm run watch",
        "clean": "rm -f *.js && rm -f *.d.ts && rm -Rf modules",
        "build": "npm run clean && tsc -d",
        "prepack": "npm run lint && npm run build",
        "postpack": "npm run clean",
        "postpublish": "git push && git push --tags",
        "pack:dev": "npm pack",
        "postpack:dev": "npm run build && mkdir -p ./build && mv ./*.tgz ./build && echo \"\nPack file path:\n$(pwd)/build/$(ls -tp ./build | grep -v '/$' | head -n 1)\n\"",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --check src"
    },
    "peerDependencies": {
        "@gtindependence/node-common": "7.1.0",
        "@nestjs/common": "^11.2.8",
        "@nestjs/core": "^11.2.8",
        "@nestjs/microservices": "^11.2.8",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/swagger": "^11.4.7",
        "@nestjs/testing": "^11.2.8",
        "axios": "^1.20.0",
        "class-validator": "^0.14.0",
        "config": "^3.3.9",
        "js-yaml": "^4.1.0",
        "log4js": "^6.9.1",
        "passport": "~0.6.0",
        "reflect-metadata": "~0.1.13",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@gtindependence/node-common": "7.1.0",
        "@nestjs/common": "^11.2.8",
        "@nestjs/core": "^11.2.8",
        "@nestjs/microservices": "^11.2.8",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/swagger": "^11.4.7",
        "@nestjs/testing": "^11.2.8",
        "@types/config": "^3.3.1",
        "@types/node": "^24.19.2",
        "@types/passport": "~1.0.13",
        "@types/redis": "^4.0.11",
        "axios": "^1.20.0",
        "class-validator": "^0.14.0",
        "config": "^3.3.9",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-node": "^0.4.0",
        "eslint-plugin-import-x": "^4.17.1",
        "js-yaml": "^4.1.0",
        "log4js": "^6.9.1",
        "passport": "~0.6.0",
        "prettier": "^3.9.10",
        "reflect-metadata": "~0.1.13",
        "rxjs": "^7.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0"
    },
    "dependencies": {
        "redis": "4.6.10"
    }
}
